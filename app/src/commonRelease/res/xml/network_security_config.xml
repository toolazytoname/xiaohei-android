<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Store traffic must use verified HTTPS. The enhanced build has its own existing LAN policy. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
