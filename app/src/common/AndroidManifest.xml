<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Common-base overlay only. tools:node=remove is not a Play/store compliance claim.
      Final merged manifest still needs flavor merge acceptance.
    -->

    <uses-feature
        android:name="android.hardware.telephony"
        tools:node="remove" />
    <uses-feature
        android:name="android.hardware.camera.any"
        tools:node="remove" />

    <!-- Enhanced build owns the legacy signature contract; store resolves a distinct inert name. -->
    <permission android:name="${xiaoheiDspPermission}" android:protectionLevel="signature" />
    <uses-permission android:name="${xiaoheiDspPermission}" />

    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_AUDIO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_VIDEO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="moe.shizuku.manager.permission.API_V23"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:node="remove" />
    <uses-permission
        android:name="com.android.alarm.permission.SET_ALARM"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.CALL_PHONE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.SEND_SMS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_SMS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.RECEIVE_SMS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.CAMERA"
        tools:node="remove" />

    <!--
      Normal permission. Needed for AudioManager.setMode / speaker routing in the
      TTS echo-route diagnostic (API 31 setCommunicationDevice or older speakerphone).
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
      After QUERY_ALL_PACKAGES is gone, SETTINGS, user file-picker, and TTS engine
      intents need package visibility. Do not re-add MAIN/LAUNCHER (too broad) or
      QUERY_ALL_PACKAGES. Accessibility provider is not a common-base promise.
      IMAGE_CAPTURE is cropper library residue.
    -->
    <queries>
        <package android:name="${xiaoheiDspCompanionPackage}" />
        <package
            android:name="com.ai.assistance.operit.provider"
            tools:node="remove" />
        <package android:name="com.android.settings" />
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PICK" />
            <data android:mimeType="image/*" />
        </intent>
        <intent>
            <action android:name="android.provider.action.PICK_IMAGES" />
        </intent>
        <!--
          Android 11+ package visibility: TextToSpeech(context) queries engines via
          android.intent.action.TTS_SERVICE. Without this intent, PackageManager
          returns no engines and SimpleVoiceProvider init is -1 even when a system
          TTS (e.g. Talkify) is installed. Standard action only; no engine package
          name and no default-engine / system-setting change. Ordinary devices must
          discover TTS without Root/QUERY_ALL_PACKAGES.
        -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent tools:node="remove">
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!--
      Common-base opts out of Auto Backup / OEM cloud restore and D2D.
      allowBackup=false alone does not stop some OEM device-transfer; XML rules
      are required. In-app user export/import is unchanged. See docs/common-backup-policy.md.
    -->
    <!--
      common and commonRelease share this overlay, so launcher mipmap cannot
      be a same-name resource override. buildType placeholders select
      ic_launcher_simple vs ic_launcher_xiaohei_enhanced. Activity names stay.
    -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="${xiaoheiCleartextAllowed}"
        android:dataExtractionRules="@xml/common_data_extraction_rules"
        android:fullBackupContent="@xml/common_backup_rules"
        android:label="${xiaoheiAppLabel}"
        android:icon="${xiaoheiLauncherIcon}"
        android:requestLegacyExternalStorage="false"
        android:roundIcon="${xiaoheiLauncherRoundIcon}"
        android:theme="@style/Theme.Operit"
        tools:replace="android:label,android:theme,android:icon,android:roundIcon,android:requestLegacyExternalStorage,android:allowBackup,android:fullBackupContent,android:dataExtractionRules,android:usesCleartextTraffic">
        <!-- Do not let upstream localized app_name strings erase variant identity. -->
        <activity
            android:name=".ui.main.MainActivity"
            android:label="${xiaoheiAppLabel}"
            tools:replace="android:label" />
        <!-- Common users share chosen attachments/exports, never the entire private data root. -->
        <provider
            android:name=".provider.OperitDataDocumentsProvider"
            tools:node="remove" />
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            tools:node="remove" />
        <provider
            android:name="com.ai.assistance.operit.terminal.provider.UbuntuDocumentsProvider"
            tools:node="remove" />

        <meta-data
            android:name="moe.shizuku.client.V3_SUPPORT"
            tools:node="remove" />

        <activity
            android:name=".integrations.tasker.ActivityConfigAIAgentAction"
            tools:node="remove" />
        <activity
            android:name=".core.tools.system.ScreenCaptureActivity"
            tools:node="remove" />
        <activity
            android:name=".integrations.tasker.WorkflowTaskerActivityConfig"
            tools:node="remove" />
        <activity
            android:name=".widget.ToolPkgDesktopWidgetConfigActivity"
            tools:node="remove" />

        <service
            android:name=".core.tools.system.ScreenCaptureService"
            tools:node="remove" />
        <service
            android:name=".services.notification.OperitNotificationListenerService"
            tools:node="remove" />
        <service
            android:name=".services.UIDebuggerService"
            tools:node="remove" />
        <service
            android:name="com.joaomgcd.taskerpluginlibrary.action.IntentServiceAction"
            tools:node="remove" />
        <service
            android:name="com.joaomgcd.taskerpluginlibrary.condition.IntentServiceCondition"
            tools:node="remove" />

        <receiver
            android:name=".core.tools.javascript.ScriptExecutionReceiver"
            tools:node="remove" />
        <receiver
            android:name=".core.tools.packTool.ToolPkgDebugInstallReceiver"
            tools:node="remove" />
        <receiver
            android:name=".core.tools.packTool.PackageDebugRefreshReceiver"
            tools:node="remove" />
        <receiver
            android:name=".core.tools.packTool.ToolPkgComposeDslDebugDumpReceiver"
            tools:node="remove" />
        <receiver
            android:name=".integrations.intent.ExternalChatReceiver"
            tools:node="remove" />
        <receiver
            android:name=".core.tools.agent.ShowerBinderReceiver"
            tools:node="remove" />
        <receiver
            android:name=".integrations.tasker.WorkflowTaskerReceiver"
            tools:node="remove" />
        <receiver
            android:name=".integrations.tasker.WorkflowBootReceiver"
            tools:node="remove" />
        <receiver
            android:name=".widget.ToolPkgDesktopWidgetReceiver"
            tools:node="remove" />
        <receiver
            android:name="com.joaomgcd.taskerpluginlibrary.action.BroadcastReceiverAction"
            tools:node="remove" />
        <receiver
            android:name="com.joaomgcd.taskerpluginlibrary.condition.BroadcastReceiverCondition"
            tools:node="remove" />
    </application>
</manifest>
